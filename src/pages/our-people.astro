---
import Layout from '../layouts/Layout.astro';

const partners = [
  {
    "name": "Usman Mughal",
    "role": "Partner",
    "title": "Co-Founder, Patent Attorney, Shareholder",
    "creds": "J.D. | M.S. | B.S.",
    "image": "https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&q=80&w=600",
    "bio": "Usman has been working in patent preparation and prosecution since 2008. He defended his M.S. thesis from NC State University on active antenna arrays, and spent 9 years as an analog/mixed-signal design engineer at Intel Corp, inventing 11 patents. He co-managed prosecution and budgeting for a major power management portfolio. His practice covers 5G RAN standards, mixed-signal circuits, antennas, volatile/non-volatile memories, semiconductors, AI hardware, and processors. Usman is listed as a \"Rising Star\" by Oregon Super Lawyers and a \"Top Lawyer\" by Portland Monthly."
  },
  {
    "name": "Kate Gaudry",
    "role": "Partner",
    "title": "Co-Founder, Patent Attorney, Shareholder",
    "creds": "Ph.D. | J.D. | B.S.",
    "image": "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=600",
    "bio": "Kate's practice spans physics, neuroscience, artificial intelligence, biology, and software. Her current focus is on AI, bioinformatics, and software, with lab experiences at Harvard, UCSD, Los Alamos National Lab, and M.D. Anderson Cancer Center. She represents clients from startups to Fortune 100 companies and universities. Kate is the Vice-Chair of the AI Task Force of the AIPLA and a dedicated advocate for the physically disabled, promoting virtual-work environments."
  },
  {
    "name": "Thomas Franklin",
    "role": "Partner",
    "title": "Co-Founder, Patent Attorney, Shareholder",
    "creds": "J.D. | B.S.",
    "image": "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=600",
    "bio": "Tom has 30 years of experience in patent prosecution, licensing, and intellectual capital management. He is an expert in portfolio management, IP audits, and strategic planning, and developed the client-facing portfolio tool, Triangle IP. He is widely recognized by Chambers USA, The Best Lawyers in America\u00ae, Legal 500 US, IAM Patent 1000, and IAM Strategy 300, and has been named a Colorado Super Lawyer and Lawyer of the Year."
  },
  {
    "name": "Chad Clark",
    "role": "Partner",
    "title": "Partner, Patent Attorney",
    "creds": "J.D. | B.S.E.E.",
    "image": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=600",
    "bio": "Chad is a Partner specializing in patent portfolio strategy, monetization, IP valuation, and high-stakes USPTO proceedings. He works closely with emerging technology companies and enterprise clients on artificial intelligence, computing architectures, and telecommunications patent strategy."
  }
];

const patentAttorneys = [
  {
    "name": "Sherif Mahmoud",
    "role": "Patent Attorney",
    "creds": "J.D. | M.S. C.S.",
    "image": "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=600",
    "bio": "Sherif is a registered Patent Attorney with deep expertise in software arts, machine learning algorithms, cloud computing infrastructures, and data security patents."
  },
  {
    "name": "Uday Shah",
    "role": "Patent Attorney",
    "creds": "J.D. | B.S. E.C.E.",
    "image": "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=600",
    "bio": "Uday specializes in electrical systems, semiconductor architectures, memory controllers, and wireless communications standards (5G/6G and IoT)."
  },
  {
    "name": "Scott Gilbert",
    "role": "Patent Attorney",
    "creds": "J.D. | B.S. M.E.",
    "image": "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&q=80&w=600",
    "bio": "Scott focuses on mechanical arts, robotics, mechatronics, advanced manufacturing processes, and materials science patent prosecution."
  }
];

const patentEngineers = [
  {
    "name": "Chris Holt",
    "role": "Patent Engineer",
    "creds": "M.S. | B.S. Physics",
    "image": "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&q=80&w=600",
    "bio": "Chris provides technical analysis and engineering support across semiconductor packaging, optical sensors, micro-electromechanical systems (MEMS), and device fabrication."
  },
  {
    "name": "Ayan Paul",
    "role": "Patent Engineer",
    "creds": "M.S. A.I. | B.S. C.E.",
    "image": "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&q=80&w=600",
    "bio": "Ayan analyzes complex technical disclosures in machine learning, neural networks, distributed systems, and applied cryptographic protocols."
  }
];

const teamStaff = [
  {
    "name": "Phoebe Young",
    "role": "Paralegal",
    "creds": "B.A.",
    "image": "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=600",
    "bio": "Phoebe specializes in docketing management, USPTO filings, and administrative legal support, bringing precise detail to file maintenance."
  },
  {
    "name": "Dana Montgomery",
    "role": "Paralegal",
    "creds": "B.A.",
    "image": "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&q=80&w=600",
    "bio": "Dana brings over 13 years of patent prosecution experience and supports partners, attorneys, and patent agents."
  },
  {
    "name": "Alanna Woods",
    "role": "Trademark Paralegal",
    "creds": "B.S.",
    "image": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=600",
    "bio": "Alanna is a Trademark Paralegal who supports the firm's trademark practice, focusing on prosecution, maintenance, and portfolio management."
  },
  {
    "name": "Joanna Cummings",
    "role": "Paralegal Assistant",
    "creds": "B.Mus.",
    "image": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=600",
    "bio": "Joanna assists with accurate docket entry, closely monitors attorney docket reports, and maintains comprehensive records."
  },
  {
    "name": "Zahra Baloch",
    "role": "Chief People Officer",
    "creds": "M.P.H. | B.S.",
    "image": "https://images.unsplash.com/photo-1573496799652-408c2ac9fe98?auto=format&fit=crop&q=80&w=600",
    "bio": "Zahra is the Chief People Officer for the firm. She manages day-to-day human resources, benefits, and payroll."
  },
  {
    "name": "Mahin Mughal",
    "role": "Law Intern",
    "creds": "J.D. | B.S.",
    "image": "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=600",
    "bio": "Mahin is a law intern at MGF who manages the firm's social media presence and assists with administrative and paralegal tasks."
  }
];
---

<Layout title="Our People | MGF Law">
  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16 font-sans">
    
    <!-- Header Hero with Stats -->
    <section class="border-b border-[#c5a880]/10 bg-[#070b16] py-16 text-center space-y-4">
      <div class="container mx-auto px-4 max-w-4xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Our People</span>
        <h1 class="text-4xl sm:text-5xl font-serif text-white leading-tight font-light">
          Meet the <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#c5a880] to-[#e4d4b1]">Team</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Our diverse team combines decades of high-level engineering experience with rigorous patent law expertise.
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-6 pt-4 max-w-md mx-auto">
          <div class="bg-[#12192c] border border-[#c5a880]/15 p-5 rounded-2xl space-y-1 shadow">
            <span class="text-3xl font-extrabold text-[#c5a880] font-mono">18</span>
            <p class="text-[11px] text-slate-300 font-bold uppercase tracking-wider">Professionals</p>
          </div>
          <div class="bg-[#12192c] border border-[#c5a880]/15 p-5 rounded-2xl space-y-1 shadow">
            <span class="text-3xl font-extrabold text-[#c5a880] font-mono">203+</span>
            <p class="text-[11px] text-slate-300 font-bold uppercase tracking-wider">Years Combined Experience</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation jump anchors -->
    <section class="border-b border-[#c5a880]/10 bg-[#0A0F1D]/80 py-4 sticky top-0 z-40 backdrop-blur-md">
      <div class="container mx-auto px-4 max-w-5xl flex flex-wrap justify-center gap-3 text-xs font-bold">
        <a href="#partners" class="px-4 py-1.5 rounded-full border border-[#c5a880]/20 text-[#c5a880] hover:bg-[#c5a880]/10 transition-all">Partners</a>
        <a href="#attorneys" class="px-4 py-1.5 rounded-full border border-[#c5a880]/20 text-[#c5a880] hover:bg-[#c5a880]/10 transition-all">Patent Attorneys</a>
        <a href="#engineers" class="px-4 py-1.5 rounded-full border border-[#c5a880]/20 text-[#c5a880] hover:bg-[#c5a880]/10 transition-all">Patent Engineers</a>
        <a href="#staff" class="px-4 py-1.5 rounded-full border border-[#c5a880]/20 text-[#c5a880] hover:bg-[#c5a880]/10 transition-all">Support Team</a>
        <a href="#commitments" class="px-4 py-1.5 rounded-full border border-[#c5a880]/40 bg-[#c5a880]/10 text-white hover:bg-[#c5a880]/20 transition-all">Our Commitments</a>
      </div>
    </section>

    <!-- Partners Section -->
    <section id="partners" class="container mx-auto px-4 py-16 max-w-5xl space-y-12">
      <div class="border-b border-[#c5a880]/15 pb-4 space-y-1">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#c5a880]">Partners</h2>
        <p class="text-xs sm:text-sm text-slate-400">Meet our founding partners and leadership team.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {partners.map((partner) => (
          <div class="bg-[#12192c] border border-[#c5a880]/15 p-6 sm:p-8 rounded-2xl space-y-5 shadow hover:border-[#c5a880]/35 transition-all">
            <div class="flex items-center gap-5 border-b border-[#c5a880]/10 pb-5">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border-2 border-[#c5a880]/30 shadow-md shrink-0 bg-[#0A0F1D]">
                <img src={partner.image} alt={partner.name} class="w-full h-full object-cover" />
              </div>
              <div class="space-y-1">
                <h3 class="text-xl sm:text-2xl font-bold text-white font-serif">{partner.name}</h3>
                <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#c5a880]/15 text-[#c5a880] font-bold text-[10px] uppercase tracking-wider">
                  {partner.role}
                </span>
                <p class="text-xs font-semibold text-slate-400 mt-1">{partner.creds}</p>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">{partner.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Patent Attorneys Section -->
    <section id="attorneys" class="container mx-auto px-4 py-12 max-w-5xl space-y-12">
      <div class="border-b border-[#c5a880]/15 pb-4 space-y-1">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#c5a880]">Patent Attorneys</h2>
        <p class="text-xs sm:text-sm text-slate-400">Experienced attorneys with deep technical backgrounds.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {patentAttorneys.map((attorney) => (
          <div class="bg-[#12192c]/80 border border-[#c5a880]/10 p-6 rounded-2xl space-y-4 shadow hover:border-[#c5a880]/30 transition-all flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center gap-4 border-b border-[#c5a880]/10 pb-4">
                <div class="w-16 h-16 rounded-xl overflow-hidden border border-[#c5a880]/25 shrink-0 bg-[#0A0F1D]">
                  <img src={attorney.image} alt={attorney.name} class="w-full h-full object-cover" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white font-serif">{attorney.name}</h3>
                  <span class="text-[10px] font-bold text-[#c5a880] uppercase tracking-wider block">{attorney.role}</span>
                  <p class="text-[10px] text-slate-400">{attorney.creds}</p>
                </div>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed font-sans">{attorney.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Patent Engineers Section -->
    <section id="engineers" class="container mx-auto px-4 py-12 max-w-5xl space-y-12">
      <div class="border-b border-[#c5a880]/15 pb-4 space-y-1">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#c5a880]">Patent Engineers</h2>
        <p class="text-xs sm:text-sm text-slate-400">Technical experts supporting patent prosecution.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {patentEngineers.map((engineer) => (
          <div class="bg-[#12192c]/80 border border-[#c5a880]/10 p-6 rounded-2xl space-y-4 shadow hover:border-[#c5a880]/30 transition-all">
            <div class="flex items-center gap-4 border-b border-[#c5a880]/10 pb-4">
              <div class="w-16 h-16 rounded-xl overflow-hidden border border-[#c5a880]/25 shrink-0 bg-[#0A0F1D]">
                <img src={engineer.image} alt={engineer.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-white font-serif">{engineer.name}</h3>
                <span class="text-[10px] font-bold text-[#c5a880] uppercase tracking-wider block">{engineer.role}</span>
                <p class="text-[10px] text-slate-400">{engineer.creds}</p>
              </div>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed font-sans">{engineer.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Staff & Support Team -->
    <section id="staff" class="container mx-auto px-4 py-12 max-w-5xl space-y-12">
      <div class="border-b border-[#c5a880]/15 pb-4 space-y-1">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#c5a880]">Support Team & Administration</h2>
        <p class="text-xs sm:text-sm text-slate-400">Dedicated professionals managing USPTO docketing, filings, and operations.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {teamStaff.map((staff) => (
          <div class="bg-[#12192c]/60 border border-[#c5a880]/10 p-5 rounded-xl space-y-3 shadow-sm hover:border-[#c5a880]/25 transition-all">
            <div class="flex items-center gap-3 border-b border-[#c5a880]/10 pb-3">
              <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#c5a880]/20 shrink-0 bg-[#0A0F1D]">
                <img src={staff.image} alt={staff.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white font-serif">{staff.name}</h3>
                <p class="text-[10px] font-semibold text-[#c5a880] uppercase tracking-wider">{staff.role}</p>
                <p class="text-[9px] text-slate-400">{staff.creds}</p>
              </div>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed font-sans line-clamp-3">{staff.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Our Commitments Section at the End of Our People Page -->
    <section id="commitments" class="container mx-auto px-4 py-16 max-w-5xl">
      <div class="bg-[#12192c] border border-[#c5a880]/20 p-8 sm:p-12 rounded-3xl shadow-xl space-y-8">
        <div class="border-b border-[#c5a880]/15 pb-4 space-y-1 text-center sm:text-left">
          <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Our Commitments</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">Diversity & Inclusion Statement</h2>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            Learn how we recruit, retain, and support a diverse, inclusive team across all practice areas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-[#0A0F1D]/80 border border-[#c5a880]/15 space-y-3">
            <h3 class="text-lg font-serif font-bold text-[#c5a880]">Recruit</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Attract talent across genders, races, ethnicities, sexual orientations, disability, and neurodiversity.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-[#0A0F1D]/80 border border-[#c5a880]/15 space-y-3">
            <h3 class="text-lg font-serif font-bold text-[#c5a880]">Retain</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Provide hands-on training, mentorship, and personalized career planning.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-[#0A0F1D]/80 border border-[#c5a880]/15 space-y-3">
            <h3 class="text-lg font-serif font-bold text-[#c5a880]">Represent</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Champion underrepresented communities through outreach and pro bono work.
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-[#c5a880]/10">
          <p class="text-xs text-slate-400 text-center sm:text-left">
            Last updated: January 09, 2024 • Minority-Owned IP Firm
          </p>
          <a href="/diversity-statement" class="px-6 py-3 rounded-xl bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] transition-all font-bold text-xs uppercase tracking-wider shadow shrink-0">
            Read Full Diversity Statement →
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
