---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Use | ASF Law">
  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16 font-sans">
    <main class="container mx-auto px-4 py-12 max-w-4xl flex-grow">
      <div class="mb-8 flex items-center justify-between border-b border-[#c5a880]/10 pb-6">
        <h1 class="text-4xl font-extrabold text-white font-serif">Terms of Use</h1>
        <a href="/" class="text-[#c5a880] hover:underline font-medium text-sm">← Back to Home</a>
      </div>

      <div class="bg-[#12192c] border border-[#c5a880]/15 p-8 sm:p-12 rounded-3xl shadow-xl space-y-8 leading-relaxed text-slate-300 text-sm sm:text-base">
        <p class="text-xs text-slate-400">Last updated: January 2026</p>

        <p>
          Welcome to <strong class="text-white font-bold">Ahsan Shahzad Firm PC (ASF Law)</strong>. By accessing or using our website and legal consultation resources, you agree to comply with and be bound by the following terms and conditions.
        </p>

        <section class="space-y-3">
          <h2 class="text-2xl font-serif font-bold text-[#c5a880]">1. Acceptance of Terms</h2>
          <p>
            By accessing, browsing, or using this website, you acknowledge that you have read, understood, and agree to be bound by these Terms of Use and to comply with all applicable laws and regulations.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-2xl font-serif font-bold text-[#c5a880]">2. No Attorney-Client Relationship</h2>
          <p>
            The materials and content on this website are for informational purposes only and do not constitute legal advice. Transmitting information through this website or communicating with ASF Law via email does not create an attorney-client relationship.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-2xl font-serif font-bold text-[#c5a880]">3. Intellectual Property Rights</h2>
          <p>
            All content on this website, including text, graphics, logos, and compilations, is the property of Ahsan Shahzad Firm PC (ASF Law) and is protected by applicable copyright and trademark laws.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-2xl font-serif font-bold text-[#c5a880]">4. Contact Information</h2>
          <p>
            If you have questions regarding these Terms of Use, please contact us at <a href="mailto:contact@asf.law" class="text-[#c5a880] underline font-semibold">contact@asf.law</a> or (971) 634-0286.
          </p>
        </section>
      </div>
    </main>
  </div>
</Layout>
