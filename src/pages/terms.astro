---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Use | Solorithm">
  <main class="container mx-auto px-4 py-12 max-w-3xl flex-grow">
    <div class="prose dark:prose-invert mx-auto">
      <h1 class="text-4xl font-extrabold mb-8">Terms of Use</h1>
      
      <p class="text-foreground-secondary mb-6">Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>

      <p class="mb-6">
        Welcome to Solorithm. By accessing or using our website (solorithm.com) and our IT consulting and managed services, you agree to comply with and be bound by the following terms and conditions. Please read them carefully.
      </p>

      <h2 class="text-2xl font-bold mt-8 mb-4">1. Acceptance of Terms</h2>
