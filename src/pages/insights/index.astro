<Layout title="Insights & Analysis | ASF Law">
  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16 font-sans">
    
    <!-- Hero Section -->
    <section class="border-b border-[#c5a880]/10 bg-[#070b16] py-20 text-center space-y-4">
      <div class="container mx-auto px-4 max-w-4xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Knowledge & Legal Commentary</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white leading-tight font-light">
          Insights & <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#c5a880] to-[#e4d4b1]">Analysis</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Expert analysis and commentary on intellectual property law, emerging technologies, and patent prosecution strategies.
        </p>
      </div>
    </section>

    <!-- Insights Articles Grid -->
    <section class="container mx-auto px-4 py-16 max-w-5xl space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {insights.map((article) => (
          <article class="bg-[#12192c] border border-[#c5a880]/15 rounded-2xl overflow-hidden shadow hover:border-[#c5a880]/40 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
            <div>
              <div class="h-52 overflow-hidden relative">
                <img src={article.image} alt={article.title} class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#12192c] via-transparent to-transparent opacity-70"></div>
                <span class="absolute top-4 left-4 px-3 py-1 text-[10px] font-bold rounded-full bg-[#0A0F1D]/80 border border-[#c5a880]/30 text-[#c5a880] uppercase tracking-wider backdrop-blur-sm">
                  {article.tags[0]}
                </span>
              </div>
              <div class="p-6 sm:p-8 space-y-3">
                <div class="flex items-center gap-3 text-xs text-slate-400">
                  <span class="font-semibold text-[#c5a880]">{article.author}</span>
                  <span>•</span>
                  <span>{article.date}</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-white leading-snug">
                  <a href={`/insights/${article.slug}`} class="hover:text-[#c5a880] transition-colors">
                    {article.title}
                  </a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-3">
                  {article.summary}
                </p>
              </div>
            </div>
            <div class="px-6 sm:px-8 pb-6 pt-2">
              <a href={`/insights/${article.slug}`} class="inline-flex items-center gap-1.5 text-xs font-bold text-[#c5a880] hover:underline">
                Read Full Article <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Newsletter Section -->
    <section class="container mx-auto px-4 py-12 max-w-4xl">
      <div class="bg-[#12192c] border border-[#c5a880]/20 p-8 sm:p-12 rounded-3xl shadow-xl space-y-6 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Stay Informed</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">Subscribe to Our Newsletter</h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
          Receive our latest insights on patent law, technology trends, and intellectual property strategy delivered directly to your inbox.
        </p>
        <form onsubmit="event.preventDefault(); alert('Thank you for subscribing to ASF Law Insights!');" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto pt-2">
          <input 
            type="email" 
            placeholder="Email address" 
            required 
            class="flex-grow px-4 py-3 text-xs rounded-xl bg-[#0A0F1D] border border-[#c5a880]/30 text-white placeholder-slate-500 focus:outline-none focus:border-[#c5a880]"
          />
          <button 
            type="submit" 
            class="px-6 py-3 rounded-xl bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] transition-all font-bold text-xs uppercase tracking-wider shadow shrink-0"
          >
            Subscribe
          </button>
        </form>
      </div>
    </section>

  </div>
</Layout>
