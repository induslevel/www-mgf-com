---

<Layout title="Meet the Team | MGF Law">
  <style is:inline>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(10, 15, 29, 0.6);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #c5a880;
      border-radius: 4px;
    }
  </style>

  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16">
    <!-- Hero Header -->
    <section class="border-b border-[#c5a880]/10 bg-[#070b16] py-20 text-center space-y-4">
      <div class="container mx-auto px-4 max-w-4xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Our People</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white leading-tight font-light">
          Meet the <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#c5a880] to-[#e4d4b1]">Team</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-3xl mx-auto leading-relaxed font-sans">
          The diverse expertise of our team matches our diverse client base. Our knowledge encompasses decades of experience accrued across a range of practice areas, spanning the intellectual property industry and related technology sectors.
        </p>
      </div>
    </section>

    <!-- Main Team Sections -->
    <div class="container mx-auto px-4 py-16 max-w-5xl space-y-24 font-sans">
      
      <!-- 1. PARTNERS SECTION -->
      <section id="partners" class="space-y-8">
        <div class="border-b border-[#c5a880]/15 pb-4">
          <h2 class="text-2xl sm:text-3xl font-serif text-[#c5a880] font-semibold tracking-wide">
            Partners
          </h2>
          <p class="text-xs text-slate-400 mt-1">Hover over any card or photo to flip and view full biography</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {partners.map((person) => (
            <div class="team-card group perspective-1000 h-[480px] w-full cursor-pointer">
              <div class="card-inner relative w-full h-full duration-700 transform-style-3d transition-transform group-hover:rotate-y-180">
                
                <!-- FRONT OF CARD -->
                <div class="card-front absolute inset-0 w-full h-full backface-hidden rounded-2xl bg-[#12192c] border border-[#c5a880]/15 p-8 flex flex-col justify-between shadow-xl">
                  <div class="space-y-6">
                    <div class="flex items-center justify-between">
                      <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#c5a880]/20 to-[#12192c] flex items-center justify-center font-serif text-[#c5a880] text-2xl font-bold border border-[#c5a880]/30 shadow-inner">
                        {person.name.split(' ').map(n => n[0]).join('')}
                      </div>
                      <div class="flex flex-wrap gap-1.5 justify-end">
                        {person.creds.map((cred) => (
                          <span class="px-2.5 py-1 text-[11px] font-bold rounded-md bg-[#0A0F1D] border border-[#c5a880]/20 text-[#c5a880]">
                            {cred}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="space-y-2">
                      <h3 class="text-2xl font-bold text-white font-serif">{person.name}</h3>
                      <p class="text-xs font-semibold text-[#c5a880] uppercase tracking-wider">{person.role}</p>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-4">
                      {person.bio}
                    </p>
                  </div>

                  <div class="pt-4 border-t border-[#c5a880]/10 flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#c5a880] group-hover:underline">
                      View Profile <span>↻</span>
                    </span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Hover to Flip</span>
                  </div>
                </div>

                <!-- BACK OF CARD (FLIPPED) -->
                <div class="card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 rounded-2xl bg-[#0d1424] border border-[#c5a880]/35 p-6 sm:p-8 flex flex-col justify-between shadow-2xl overflow-hidden">
                  <div class="space-y-3 flex-1 flex flex-col min-h-0">
                    <div class="border-b border-[#c5a880]/15 pb-3">
                      <div class="flex items-center justify-between">
                        <h4 class="text-lg font-bold text-white font-serif">{person.name}</h4>
                        <div class="flex gap-1">
                          {person.creds.map((cred) => (
                            <span class="text-[10px] font-bold text-[#c5a880] bg-[#c5a880]/10 px-1.5 py-0.5 rounded">
                              {cred}
                            </span>
                          ))}
                        </div>
                      </div>
                      <p class="text-[10px] text-[#c5a880] uppercase font-semibold tracking-wider mt-0.5">{person.role}</p>
                    </div>

                    <!-- Scrollable Bio -->
                    <div class="overflow-y-auto custom-scrollbar flex-1 pr-2 space-y-2.5 text-xs text-slate-300 leading-relaxed">
                      <p>{person.bio}</p>
                    </div>
                  </div>

                  <div class="pt-3 border-t border-[#c5a880]/10 flex items-center justify-between shrink-0">
                    <a href="/contact" class="text-xs font-bold text-[#c5a880] hover:underline flex items-center gap-1">
                      Consult with {person.name.split(' ')[0]} <span>→</span>
                    </a>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Flip ↺</span>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 2. ATTORNEYS AND ENGINEERS SECTION -->
      <section id="attorneys-engineers" class="space-y-8">
        <div class="border-b border-[#c5a880]/15 pb-4">
          <h2 class="text-2xl sm:text-3xl font-serif text-[#c5a880] font-semibold tracking-wide">
            Attorneys and Engineers
          </h2>
          <p class="text-xs text-slate-400 mt-1">Specialized engineering backgrounds spanning computing, biomedical, physics, and chemistry</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {attorneysEngineers.map((person) => (
            <div class="team-card group perspective-1000 h-[480px] w-full cursor-pointer">
              <div class="card-inner relative w-full h-full duration-700 transform-style-3d transition-transform group-hover:rotate-y-180">
                
                <!-- FRONT OF CARD -->
                <div class="card-front absolute inset-0 w-full h-full backface-hidden rounded-2xl bg-[#12192c] border border-[#c5a880]/15 p-8 flex flex-col justify-between shadow-xl">
                  <div class="space-y-6">
                    <div class="flex items-center justify-between">
                      <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#c5a880]/20 to-[#12192c] flex items-center justify-center font-serif text-[#c5a880] text-2xl font-bold border border-[#c5a880]/30 shadow-inner">
                        {person.name.split(' ').map(n => n[0]).join('')}
                      </div>
                      <div class="flex flex-wrap gap-1.5 justify-end">
                        {person.creds.map((cred) => (
                          <span class="px-2.5 py-1 text-[11px] font-bold rounded-md bg-[#0A0F1D] border border-[#c5a880]/20 text-[#c5a880]">
                            {cred}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="space-y-2">
                      <h3 class="text-2xl font-bold text-white font-serif">{person.name}</h3>
                      <p class="text-xs font-semibold text-[#c5a880] uppercase tracking-wider">{person.role}</p>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-4">
                      {person.bio}
                    </p>
                  </div>

                  <div class="pt-4 border-t border-[#c5a880]/10 flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#c5a880] group-hover:underline">
                      View Profile <span>↻</span>
                    </span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Hover to Flip</span>
                  </div>
                </div>

                <!-- BACK OF CARD (FLIPPED) -->
                <div class="card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 rounded-2xl bg-[#0d1424] border border-[#c5a880]/35 p-6 sm:p-8 flex flex-col justify-between shadow-2xl overflow-hidden">
                  <div class="space-y-3 flex-1 flex flex-col min-h-0">
                    <div class="border-b border-[#c5a880]/15 pb-3">
                      <div class="flex items-center justify-between">
                        <h4 class="text-lg font-bold text-white font-serif">{person.name}</h4>
                        <div class="flex gap-1">
                          {person.creds.map((cred) => (
                            <span class="text-[10px] font-bold text-[#c5a880] bg-[#c5a880]/10 px-1.5 py-0.5 rounded">
                              {cred}
                            </span>
                          ))}
                        </div>
                      </div>
                      <p class="text-[10px] text-[#c5a880] uppercase font-semibold tracking-wider mt-0.5">{person.role}</p>
                    </div>

                    <!-- Scrollable Bio -->
                    <div class="overflow-y-auto custom-scrollbar flex-1 pr-2 space-y-2.5 text-xs text-slate-300 leading-relaxed">
                      <p>{person.bio}</p>
                    </div>
                  </div>

                  <div class="pt-3 border-t border-[#c5a880]/10 flex items-center justify-between shrink-0">
                    <a href="/contact" class="text-xs font-bold text-[#c5a880] hover:underline flex items-center gap-1">
                      Consult with {person.name.split(' ')[0]} <span>→</span>
                    </a>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Flip ↺</span>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. SUPPORT STAFF SECTION -->
      <section id="support-staff" class="space-y-8">
        <div class="border-b border-[#c5a880]/15 pb-4">
          <h2 class="text-2xl sm:text-3xl font-serif text-[#c5a880] font-semibold tracking-wide">
            Support Staff
          </h2>
          <p class="text-xs text-slate-400 mt-1">Dedicated paralegals, docketing managers, and operations specialists</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {supportStaff.map((person) => (
            <div class="team-card group perspective-1000 h-[440px] w-full cursor-pointer">
              <div class="card-inner relative w-full h-full duration-700 transform-style-3d transition-transform group-hover:rotate-y-180">
                
                <!-- FRONT OF CARD -->
                <div class="card-front absolute inset-0 w-full h-full backface-hidden rounded-2xl bg-[#12192c] border border-[#c5a880]/15 p-6 flex flex-col justify-between shadow">
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <div class="w-14 h-14 rounded-xl bg-[#c5a880]/10 flex items-center justify-center font-serif text-[#c5a880] text-lg font-bold border border-[#c5a880]/20">
                        {person.name.split(' ').map(n => n[0]).join('')}
                      </div>
                      <div class="flex flex-wrap gap-1 justify-end">
                        {person.creds.map((cred) => (
                          <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-[#0A0F1D] border border-[#c5a880]/20 text-[#c5a880]">
                            {cred}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div>
                      <h3 class="text-xl font-bold text-white font-serif">{person.name}</h3>
                      <p class="text-xs font-semibold text-[#c5a880] uppercase tracking-wider">{person.role}</p>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed line-clamp-4">
                      {person.bio}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-[#c5a880]/10 flex items-center justify-between">
                    <span class="text-xs font-bold text-[#c5a880] group-hover:underline">
                      View Profile ↻
                    </span>
                    <span class="text-[9px] text-slate-400 uppercase font-semibold">Hover to Flip</span>
                  </div>
                </div>

                <!-- BACK OF CARD (FLIPPED) -->
                <div class="card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 rounded-2xl bg-[#0d1424] border border-[#c5a880]/30 p-6 flex flex-col justify-between shadow-xl overflow-hidden">
                  <div class="space-y-2 flex-1 flex flex-col min-h-0">
                    <div class="border-b border-[#c5a880]/15 pb-2">
                      <h4 class="text-base font-bold text-white font-serif">{person.name}</h4>
                      <p class="text-[10px] text-[#c5a880] uppercase font-semibold tracking-wider">{person.role}</p>
                    </div>

                    <!-- Scrollable Bio -->
                    <div class="overflow-y-auto custom-scrollbar flex-1 pr-1 space-y-2 text-xs text-slate-300 leading-relaxed">
                      <p>{person.bio}</p>
                    </div>
                  </div>

                  <div class="pt-2 border-t border-[#c5a880]/10 flex items-center justify-between shrink-0">
                    <span class="text-[10px] text-slate-400 uppercase font-semibold">MGF Law Staff</span>
                    <span class="text-[10px] text-[#c5a880] font-bold">Flip ↺</span>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. QUOTE BLOCK -->
      <section class="bg-gradient-to-r from-[#12192c] via-[#1a233d] to-[#12192c] border border-[#c5a880]/20 rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute -top-6 left-1/2 -translate-x-1/2 text-8xl font-serif text-[#c5a880]/10 select-none pointer-events-none">
          “
        </div>
        <div class="relative z-10 max-w-3xl mx-auto space-y-6">
          <p class="text-lg sm:text-2xl font-serif text-white italic leading-relaxed">
            “We have engineering experience and knowledge to evaluate your patent portfolio. You work to unique requirements. We offer unique solutions.”
          </p>
          <div class="space-y-1">
            <h4 class="text-base font-bold text-[#c5a880] uppercase tracking-wider">Usman Mughal</h4>
            <p class="text-xs text-slate-400 font-medium">Co-Founder, Patent Attorney, Shareholder</p>
          </div>
        </div>
      </section>

      <!-- 5. MEMBERSHIPS & TRUSTED INSTITUTIONS -->
      <section class="space-y-8 pt-4">
        <div class="text-center space-y-2 max-w-2xl mx-auto">
          <span class="text-xs font-bold uppercase tracking-widest text-[#c5a880]">Our Memberships & Background</span>
          <h2 class="text-2xl sm:text-3xl font-serif text-white">Distinguished Credentials</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Our professionals are registered with the USPTO and maintain active memberships in leading intellectual property organizations, ensuring we stay at the forefront of patent law developments and best practices.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 items-center justify-items-center">
          {memberships.map((inst) => (
            <div class="w-full bg-[#12192c] border border-[#c5a880]/10 rounded-xl p-4 text-center hover:border-[#c5a880]/30 transition-all shadow-sm">
              <span class="text-xs sm:text-sm font-bold text-slate-200 font-serif block">{inst}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. CONTACT CTA -->
      <section class="border-t border-[#c5a880]/15 pt-16 text-center space-y-6">
        <h3 class="text-3xl sm:text-4xl font-serif text-white font-light">
          Protect Your Innovations Globally
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-md mx-auto leading-relaxed">
          Speak with our team of specialized patent attorneys and engineers today.
        </p>
        <div class="pt-2">
          <a href="/contact" class="inline-block px-8 py-4 rounded-lg bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] transition-all font-extrabold text-sm tracking-wider uppercase shadow-lg shadow-[#c5a880]/10 hover:scale-[1.02] active:scale-[0.98]">
            TALK TO US
          </a>
        </div>
      </section>

    </div>
  </div>

  <script is:inline>
    // Enable touch / click toggle for mobile devices
    function initCardFlips() {
      const cards = document.querySelectorAll('.team-card');
      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          // If clicked a link inside the card back, allow normal navigation
          if (e.target.tagName === 'A' || e.target.closest('a')) return;
          const inner = card.querySelector('.card-inner');
          if (inner) {
            inner.classList.toggle('rotate-y-180');
          }
        });
      });
    }

    document.addEventListener('astro:page-load', initCardFlips);
    initCardFlips();
  </script>
</Layout>
