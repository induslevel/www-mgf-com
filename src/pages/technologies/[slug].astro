---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const technologies = [
  {
    "slug": "artificial-intelligence",
    "title": "Artificial Intelligence",
    "category": "Software & Algorithms",
    "shortDesc": "Machine learning, neural networks, fintech, and business methods. We protect innovations in AI algorithms, data processing, and intelligent systems.",
    "image": "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=1200",
    "overview": "Artificial Intelligence (AI) has taken the high-tech industry on a growth trajectory. Autonomous vehicles are getting closer to reality. We have the knowledge to learn complex models and understand high performance inference chips that are essential building blocks to AI.",
    "sections": [
      {
        "heading": "Data-Driven AI Protection",
        "content": "Our team has extensive data-driven experience protecting innovation in and relating to artificial intelligence. Our practice and studies have informed us to steer the express language of the claims, to the extent possible while still protecting the valuable core innovation, away from non-technical terminology such as: financial or business terminology, as such; vague benefits-oriented language; legal, social, or other human activity; basic signal and image processing steps; and content management. This leads us to claims that are consistently focused on a technical point of novelty linked to hard technology; applied novel algorithms; particularities of new technologies or data structures; and novel computer and artificial intelligence architectures."
      },
      {
        "heading": "Claim Architecture & Enforcement",
        "content": "The technical points of novelty at the center of our claims are consistently protected as methods, systems, and articles to provide our clients with a range of enforcement opportunities. In many scenarios for innovations relating to machine learning, the core value to the company occurs after machine learning model is applied rather than during the model training phase. In all our cases, we layer in a variety of technical and architectural aspects of the innovation to ensure not only that our first approach has a reasonable likelihood of success but also that the specification and dependent claims include many directions of back-up approaches and examples that are helpful to guide the application to allowance."
      },
      {
        "heading": "Invention Disclosure & Technical Depth",
        "content": "Our team spends most of the invention disclosure meeting discussing the cool, valuable, and technical aspects of the innovation with the inventors. We guide their discussion towards computer architecture and fine-grained computer-implemented steps, well beyond the high-level business slides they present to customers. Inventors are often excited to unpack the details and discuss the invention at a deeper and richer level that is more valuable to the company. In the finance sector in particular, resting the discussion at a high-level business-centric approach will not help the client obtain the patent protection they need. For example, we have protected innovation relating to feature and prompt engineering, model architectures and blended models, applied algorithms combining supervised and unsupervised techniques, and computing efficiency tradeoffs in feature-space traversal and algorithm selection."
      }
    ],
    "sampleApplications": [
      "US Publication No. 2020-0303343"
    ]
  },
  {
    "slug": "biological-arts",
    "title": "Biological Arts",
    "category": "Life Sciences & Biotech",
    "shortDesc": "Biotechnology, diagnostics, and biomedical innovations spanning devices, assays, and therapeutics.",
    "image": "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&q=80&w=1200",
    "overview": "We support inventors across biological and life-science disciplines, from diagnostic platforms and biomarkers to biomedical devices and bioinformatics. Our team pairs technical rigor with prosecution strategy to protect complex wet-lab workflows, instrumentation, and data-driven discoveries.",
    "sections": [
      {
        "heading": "Computational Biology and Bioinformatics",
        "content": "Modern biology is increasingly data-driven. Our team includes patent attorneys with Ph.D. expertise in computational neurobiology and deep experience in bioinformatics. We understand the specific challenges of protecting In Silico Discovery (algorithms predicting protein structure or identifying drug candidates), Genomic Pipelines (methods for processing next-generation sequencing data), and Diagnostic Algorithms (machine learning models trained on biological datasets)."
      },
      {
        "heading": "What Makes Biotech Patents Hard",
        "content": "Biological systems can be variable, and the prior art can be crowded. We draft specifications that preserve multiple fallbacks and focus on reproducible technical details, including control conditions, ranges, alternative embodiments, and data-driven support for claimed performance."
      },
      {
        "heading": "Claim Strategy That Matches The Product",
        "content": "Where appropriate, we build coverage across composition and kit claims, method and workflow claims tied to measurable outcomes, device and system claims for instrumentation and automation, and software/data processing claims when the innovation is technical and specific."
      },
      {
        "heading": "How We Work",
        "content": "We align on the product, the differentiators, and what competitors are likely to copy; map the invention into claimable units and define fallback positions; draft the application with clear definitions, examples, and figure support; and prosecute with a focus on enforceable scope and a clean record."
      }
    ],
    "sampleApplications": [
      "Patent strategies for diagnostic assays and biomarkers",
      "Device protections for lab automation and bio-instrumentation",
      "IP coverage for biotech software and data platforms"
    ]
  },
  {
    "slug": "chemical-arts",
    "title": "Chemical Arts",
    "category": "Chemistry & Materials",
    "shortDesc": "Chemical compounds, materials science, and pharmaceutical innovations. We protect your chemistry-based inventions.",
    "image": "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&q=80&w=1200",
    "overview": "With engineering and chemistry backgrounds, we understand the chemistry behind your inventions, and can draft applications to protect your chemical inventions. For example, our attorneys can help you protect your paint compounds, new adhesives, new alloys, sensing compounds, fertilizers, medicines, petroleum products, plastics, etc.",
    "sections": [
      {
        "heading": "Materials Science & Process Chemistry",
        "content": "Our approach to chemistry is deeply informed by our background in semiconductor fabrication and advanced manufacturing. We understand that in high-tech industries, 'chemistry' often means process integration. We help protect Thin Film Deposition (precursors and reaction kinetics for ALD, CVD, and PVD processes), Etch Chemistries (selective removal of materials in complex stacks), and Advanced Materials (novel dielectrics, photoresists, and conductive polymers used in next-gen devices)."
      },
      {
        "heading": "Key Drafting Considerations",
        "content": "Strong chemical patents usually depend on clear support for variations. We focus on defining structures, ranges, and functional parameters with precision; including alternative embodiments and optional ingredients to avoid narrow coverage; describing preparation steps and test methods so results are reproducible; and connecting properties to real-world uses so the invention is not abstract."
      },
      {
        "heading": "Claim Strategy & How We Work",
        "content": "Depending on the invention, we build a layered claim set that can include composition claims, method claims, and use claims. We also consider how competitors might design around by swapping ingredients, shifting ranges, or changing process steps, and we draft to preserve enforceable fallbacks. We review your data, map claim coverage, and prosecute with an eye toward scope that holds up in real-world enforcement."
      }
    ],
    "sampleApplications": [
      "US Patent No. 10,910,556",
      "US Publication No. 2019-0386202"
    ]
  },
  {
    "slug": "data-security-identity",
    "title": "Data Security & Identity",
    "category": "Security & Infrastructure",
    "shortDesc": "Zero-trust data protection, device identity, tokenized access, and audit-ready controls for cloud and edge workloads.",
    "image": "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&q=80&w=1200",
    "overview": "We help clients secure data and access paths across cloud, edge, and enterprise environments. Our work covers identity-centric architectures, device identifiers, signed requests, and token-based authorization that keep sensitive workflows locked to the right users and systems.",
    "sections": [
      {
        "heading": "Cryptographic and Hardware Roots of Trust",
        "content": "Security isn't just software; it starts at the silicon. Drawing on our background in encrypted data links and cryptographic design, we help protect innovations that bridge the gap between hardware and high-level policy. This includes Secure Enclaves & TEEs (protecting key material and execution environments), Blockchain & Ledger Tech (distributed consensus mechanisms and immutable logging), and Device Identity (PUFs - Physical Unclonable Functions - and hardware-backed attestation)."
      },
      {
        "heading": "Identity-Centric Architectures",
        "content": "Modern security moves beyond the perimeter. We draft claims that capture the dynamic nature of access control: Zero-Trust Flows (continuous verification, least-privilege access, and just-in-time credentialing), Token Economies (OAuth, JWT, and custom authorization schemes), and Policy Engines governing context-aware resource access."
      },
      {
        "heading": "How We Help",
        "content": "We work with engineering teams to turn architecture and threat models into patent-ready disclosures. We understand the difference between a generic 'encrypting step' and a novel key management lifecycle. We build claim sets that cover key integration points\u2014gateways, agents, SDKs, and identity providers\u2014so your IP covers the actual enforcement points in your stack."
      }
    ],
    "sampleApplications": [
      "Zero-trust access control platforms",
      "Identity-bound data tokenization workflows"
    ]
  },
  {
    "slug": "electrical-arts-consumer-electronics",
    "title": "Electrical Arts and Consumer Electronics",
    "category": "Electronics & Systems",
    "shortDesc": "Circuits, optics, memories, and batteries. We protect innovations in consumer devices, power systems, and electronic components.",
    "image": "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&q=80&w=1200",
    "overview": "We have designed and helped inventors realize inventions in the electrical and consumer art space. Our technical expertise is vast and includes high-level architectures to circuit-level implementations. For example, we understand circuits, power management, graphics, video, memory, displays, tablets, smart devices, wearable devices, medical devices, etc.",
    "sections": [
      {
        "heading": "Hardware-Level Expertise",
        "content": "Our team includes former engineers from defense and aerospace (Lockheed Martin, L3 Communications) who have managed complex projects involving ASIC/FPGA design, digital circuits, and wireless data links. We understand the constraints of real-world hardware\u2014timing closure, power budgets, and signal integrity\u2014and we write patents that respect those physical realities."
      },
      {
        "heading": "Wireless and Telemetry Systems",
        "content": "We have deep experience protecting communications infrastructure, including Satellite and Terrestrial Links (transponders, phased arrays, encrypted data links), RF Front-Ends (antenna design, beamforming, signal processing chains), and Networking Protocols (PHY/MAC layer innovations driving 5G and IoT connectivity)."
      },
      {
        "heading": "Turning Architecture Into Enforceable Claims",
        "content": "Strong electrical patents usually require multiple viewpoints. We often draft a layered set of claims covering Circuit-Level Structure (transistors, amplifiers, filters), System Behavior (control loops, state machines), and Integration Claims (how the component sits within a larger consumer device to capture downstream value)."
      },
      {
        "heading": "Practical Drafting Details",
        "content": "We focus on clear figure strategy and definitions so that terms remain consistent from specification to claims. When useful, we include timing diagrams, state machines, block diagrams, and example parameter ranges to preserve scope and help withstand enablement and definiteness challenges."
      }
    ],
    "sampleApplications": [
      "US Patent No. 11,295,796",
      "US Patent No. 11,303,280",
      "US Publication No: 2020-0144496"
    ]
  },
  {
    "slug": "mechanical-arts",
    "title": "Mechanical Arts",
    "category": "Engineering & Manufacturing",
    "shortDesc": "Mechanical systems, manufacturing processes, and physical devices. We protect innovations in mechanical engineering.",
    "image": "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&q=80&w=1200",
    "overview": "Our attorneys are hands on experts and understand mechanical arts such as components of vehicles, heavy machinery, lathe machines, rockets, consumer products, etc.",
    "sections": [
      {
        "heading": "Mechatronics and Packaging",
        "content": "In the modern world, 'mechanical' rarely means just gears and levers. It means the integration of physical systems with electronics and control logic. Our background in chip packaging, thermal management, and consumer electronics allows us to protect Electronic Packaging (heat spreaders, interconnects, enclosure designs solving thermal and EMI challenges), Actuators & Robotics (precision motion control systems), and Industrial Automation fixtures."
      },
      {
        "heading": "Drafting For Real-World Enforceability",
        "content": "A strong mechanical application does more than describe a single embodiment. We focus on clear definition of components, interfaces, and alternative geometries; figures showing multiple views and variations; parameter ranges supporting breadth; and method claims for assembly or operation."
      },
      {
        "heading": "Claim Strategy & How We Work",
        "content": "We build layered claims that cover structural features, subassemblies, and systems, plus method claims for assembly or operation when useful. We also consider how competitors might design around by changing dimensions, materials, or attachment methods, and draft to preserve meaningful fallbacks."
      }
    ],
    "sampleApplications": [
      "US Patent No. 11,073,411"
    ]
  },
  {
    "slug": "semiconductor-optical-mems-devices",
    "title": "Semiconductor, Optical, and MEMS Devices",
    "category": "Hardware & Materials",
    "shortDesc": "Process, packaging, and tools expertise. From chip design to fabrication methods, we cover the full semiconductor stack.",
    "image": "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=1200",
    "overview": "Some of us worked in state of the art fabs for semiconductor processing. Our technical expertise is vast and includes in-depth knowledge of transistors, optical transmitters and receivers, optical sensors, LEDs, reflectors, MEM devices and their usage, magnetic logic devices, beyond CMOS technologies, RF devices, etc. In addition to devices, we also have extensive expertise in chip packaging technologies.",
    "sections": [
      {
        "heading": "Analog, Mixed-Signal, and I/O Design",
        "content": "We don't just prosecute 'chips'; we understand the circuit topology. Our team includes former Intel analog designers with firsthand experience in PLLs, DLLs, high-speed I/O, voltage regulators, and clock distribution. We understand the difference between a schematic and a layout, and how parasitic effects, thermal management, and process variations impact patentability and claim structure."
      },
      {
        "heading": "Process and Packaging Realities",
        "content": "Innovations often happen at the intersection of the die and the package. We have specific experience protecting Advanced Packaging (2.5D/3D integration, wire bonding, flip-chip, through-silicon vias), Thermal Management (on-die thermal sensors, heat spreaders, dynamic thermal throttling), and Process Technology (novel transistor structures like FinFET, GAA, interconnects, and material layers)."
      },
      {
        "heading": "What We Focus On In Drafting",
        "content": "We draft applications to preserve multiple claim angles, knowing that infringement can be detected at different stages: Device Structure (physical layers and doping profiles visible in teardowns), Circuit Behavior (functional claims covering switching, regulation, and signal integrity), and Testing & Calibration (wafer sort, binning, and post-package repair)."
      },
      {
        "heading": "Practical Considerations",
        "content": "Because semiconductor innovations can be incremental and prior art is dense, we focus on clear definitions, specific parameter ranges, and alternative embodiments. We draft with an eye toward what competitors can copy in production and how a claim can be enforced against real products\u2014whether through reverse engineering or datasheet specifications."
      }
    ],
    "sampleApplications": [
      "US Publication No. 2020-0144496",
      "US Patent No. 10,984,937",
      "US Patent No. 11,171,115"
    ]
  },
  {
    "slug": "software-arts",
    "title": "Software Arts",
    "category": "Software & Computing",
    "shortDesc": "Software algorithms, applications, and computing innovations. We navigate the complex landscape of software patents.",
    "image": "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=1200",
    "overview": "We have computer engineering backgrounds and have extensive coding experience. We understand algorithms and can protect your ideas even when software arts are relatively challenging to protect. We understand the changing case law on software claims, and have successfully helped clients protect their software inventions.",
    "sections": [
      {
        "heading": "Applied Algorithms and Control Systems",
        "content": "We differentiate ourselves by protecting software that does something. Leveraging our background in telemetry, wireless data links, and debug software, we focus on Control Logic (software governing physical systems, from satellite transponders to memory controllers), Signal Processing (algorithms that clean, compress, or transform audio, video, RF data), and Embedded Systems (firmware and low-level code where resource constraints drive innovation)."
      },
      {
        "heading": "Drafting With Eligibility In Mind",
        "content": "Software claims can face eligibility challenges, so we focus on technical specificity and measurable improvements. That includes clearly describing the computing problem, the constraints, and the concrete mechanism that improves performance, security, reliability, or resource usage."
      },
      {
        "heading": "Claim Strategy & How We Work",
        "content": "We build layered claim sets including system and method claims tied to data flows and control points, claims focused on data representations, state transitions, and processing steps, and computer-readable medium claims where appropriate. We review architecture, map into claimable units, and draft with diagrams and flows."
      }
    ],
    "sampleApplications": [
      "US Patent No. 10,575,331"
    ]
  }
];

  return technologies.map((tech) => ({
    params: { slug: tech.slug },
    props: { tech, allTechnologies: technologies }
  }));
}

const { tech, allTechnologies } = Astro.props;
const otherTechnologies = allTechnologies.filter((t) => t.slug !== tech.slug);
---

<Layout title={`${tech.title} | MGF Law`}>
  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16 font-sans">
    <main class="container mx-auto px-4 py-12 max-w-5xl flex-grow w-full">
      
      <!-- Breadcrumb -->
      <div class="mb-8 flex items-center justify-between border-b border-[#c5a880]/10 pb-4">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 font-medium">
          <a href="/" class="hover:text-[#c5a880] transition-colors">Home</a>
          <span>/</span>
          <a href="/technologies" class="hover:text-[#c5a880] transition-colors">Technologies</a>
          <span>/</span>
          <span class="text-[#c5a880]">{tech.title}</span>
        </div>
        <a href="/technologies" class="text-[#c5a880] hover:underline font-bold text-xs sm:text-sm">← All Technologies</a>
      </div>

      <!-- Header Section -->
      <div class="mb-8 space-y-4">
        <span class="inline-block px-3 py-1 text-[10px] font-bold rounded-full border border-[#c5a880]/30 bg-[#c5a880]/5 text-[#c5a880] tracking-wider uppercase">
          {tech.category}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold text-white leading-tight font-serif">
          {tech.title}
        </h1>
        <p class="text-sm sm:text-lg text-slate-300 font-medium leading-relaxed max-w-3xl">
          {tech.overview}
        </p>
      </div>

      <!-- Featured Image Banner -->
      <div class="relative w-full h-[300px] sm:h-[440px] rounded-2xl overflow-hidden border border-[#c5a880]/15 mb-12 shadow-xl">
        <img src={tech.image} alt={tech.title} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0F1D] via-transparent to-transparent opacity-85"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          
          {tech.sections.map((section) => (
            <section class="space-y-4">
              <h2 class="text-xl sm:text-2xl font-bold font-serif text-[#c5a880] border-b border-[#c5a880]/15 pb-2">
                {section.heading}
              </h2>
              <p class="text-slate-300 leading-relaxed text-sm sm:text-base whitespace-pre-line">
                {section.content}
              </p>
            </section>
          ))}

          {tech.sampleApplications && tech.sampleApplications.length > 0 && (
            <section class="bg-[#12192c] border border-[#c5a880]/15 p-6 sm:p-8 rounded-2xl shadow space-y-4">
              <h3 class="text-lg sm:text-xl font-bold font-serif text-white">Sample Applications & Work</h3>
              <ul class="space-y-2.5">
                {tech.sampleApplications.map((app) => (
                  <li class="flex items-center gap-3 text-xs sm:text-sm text-slate-300 font-medium">
                    <span class="w-2 h-2 rounded-full bg-[#c5a880] shrink-0"></span>
                    <span>{app}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Other Technologies Grid -->
          <section class="pt-8 border-t border-[#c5a880]/10 space-y-6">
            <h3 class="text-xl font-serif font-bold text-white">Other Technology Areas</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {otherTechnologies.slice(0, 6).map((other) => (
                <a href={`/technologies/${other.slug}`} class="p-4 rounded-xl bg-[#12192c]/60 border border-[#c5a880]/10 hover:border-[#c5a880]/30 transition-all group flex items-center justify-between">
                  <div>
                    <h4 class="text-sm font-bold text-white group-hover:text-[#c5a880] transition-colors font-serif">{other.title}</h4>
                    <p class="text-[10px] text-[#c5a880] uppercase tracking-wider">{other.category}</p>
                  </div>
                  <span class="text-xs text-[#c5a880] group-hover:translate-x-1 transition-transform">→</span>
                </a>
              ))}
            </div>
          </section>

        </div>

        <!-- Sidebar Call to Action -->
        <div class="bg-[#12192c] border border-[#c5a880]/15 p-6 rounded-2xl shadow lg:col-span-1 sticky top-6 space-y-6">
          <div>
            <h3 class="text-base sm:text-lg font-bold font-serif text-white mb-2">Protect Your Technology</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Our attorneys are former engineers with hands-on expertise in {tech.title}. Schedule a technical consultation.
            </p>
          </div>

          <div class="space-y-3 pt-4 border-t border-[#c5a880]/10 text-xs">
            <div class="flex items-center gap-2 text-slate-300">
              <span class="text-[#c5a880]">📍</span>
              <span>1500 NW Bethany Blvd., Suite 200 Beaverton, OR 97006</span>
            </div>
            <div class="flex items-center gap-2 text-slate-300">
              <span class="text-[#c5a880]">📞</span>
              <a href="tel:9716340286" class="hover:text-[#c5a880] font-semibold">(971) 634-0286</a>
            </div>
            <div class="flex items-center gap-2 text-slate-300">
              <span class="text-[#c5a880]">✉️</span>
              <a href="mailto:contact@mgf.law" class="hover:text-[#c5a880]">contact@mgf.law</a>
            </div>
          </div>

          <div class="pt-2">
            <a
              href={`/contact?subject=${encodeURIComponent('Brief: Inquiry on ' + tech.title)}`}
              class="block text-center font-extrabold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all uppercase tracking-wider bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] shadow shadow-[#c5a880]/10"
            >
              TALK TO US
            </a>
          </div>

          <div class="text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">
              Mon-Fri 9AM-5PM PST
            </span>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
