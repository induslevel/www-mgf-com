---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const services = [
    {
      slug: "foreign-patent-prosecution",
      title: "Foreign Patent Prosecution",
      subtitle: "Globally Coherent IP Protection Across International Jurisdictions",
      category: "Preparation & Filing",
      image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1000",
      description: "Every country has its own Patent laws and rules. We have successfully prosecuted patent applications in China, Japan, European Union, India, South Korea, Australia, and other countries. We partner with expert foreign patent attorneys to navigate the complex foreign patent laws and rules. We ensure that patent prosecution of your foreign matters is consistent with your US prosecution. Drawing on experience managing global portfolios for major semiconductor and tech companies, we approach foreign prosecution with an eye on the budget and the business goal. We understand that foreign filing costs can balloon quickly. We help you manage this by consolidating instructions, strategically deferring costs, and harmonizing claims.",
      bullets: [
        "Coordinated Claim Strategy: Setting a consistent claim strategy across jurisdictions, including fallback positions and scope priorities.",
        "Local Counsel Network: Coordinating with trusted local counsel for filing, prosecution, and formalities in each country or region.",
        "Cost Management & Deferral: Strategically deferring costs where possible using PCT timelines and PPH (Patent Prosecution Highway).",
        "Symmetric Prosecution Record: Keeping the foreign record aligned with your US prosecution goals, without creating unnecessary inconsistencies."
      ],
      vision: "To provide seamless, globally unified intellectual property coverage that scales with your commercial footprint, ensuring enforceability in all critical manufacturing and sales hubs.",
      mission: "To manage international prosecution with extreme administrative and financial efficiency, coordinating with local experts to deliver predictable, robust global patent rights."
    },
    {
      slug: "patent-preparation",
      title: "Patent Preparation",
      subtitle: "Engineering-First Patent Drafting Capturing True Inventive Concept",
      category: "Preparation & Filing",
      image: "https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&q=80&w=1000",
      description: "A patent application comprises three main sections–written description, figures, and claims. The written description and figures provide support for the claims. The claims define the boundaries of the desired monopoly rights. We understand your complicated and diverse technologies. We have the technical education and expertise to understand complex inventions in a broad spectrum of technologies, which means we get to the heart of the invention efficiently. This saves time and money. Our attorneys are engineers first, with backgrounds at companies like Intel, Lockheed Martin, and L3 Communications, allowing us to deconstruct your technology and build strong protection around it.",
      bullets: [
        "Engineering-Driven Drafting: Capturing system-level architecture, component-level detail, and implementation variants.",
        "Clarity & Optionality: Formulating multiple claim tiers (broad to narrow) and fallback positions to match your product roadmap.",
        "Alternative Embodiments: Drafting alternative designs to anticipate product modifications and prevent competitor workarounds.",
        "Figure Strategy: Crafting comprehensive figures that support claim breadth and future continuation strategies."
      ],
      vision: "To translate complex technological breakthroughs into bulletproof legal instruments that withstand aggressive litigation and maximize corporate value.",
      mission: "To provide a highly technical, collaborative drafting process that respects our client's engineering timelines and delivers elite patent assets."
    },
    {
      slug: "patent-prosecution",
      title: "Patent Prosecution",
      subtitle: "Data-Driven Prosecution & Negotiation with the USPTO",
      category: "Preparation & Filing",
      image: "https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&q=80&w=1000",
      description: "After a patent application is filed, the process of patent prosecution begins. Patent prosecution involves responding to Office Actions issued by the United State Patent and Trademark Office to carve out the monopoly rights you deserve. From the start, we apprise the Examiner about your patent application and negotiate amendments to claims with little prosecution history. When we have to, we appeal your matter before the PTAB to defend the scope of the claims in view of the cited art or Examiner's legal position. We use a data-driven \"moneyball\" approach, analyzing examiner statistics, art unit trends, and appeal outcomes to tailor our strategy.",
      bullets: [
        "Data-Driven Prosecution: Analyzing examiner statistics, art unit trends, and appeal histories to optimize responses.",
        "Active Examiner Interviews: Well-prepared interviews to clarify claim interpretation, build rapport, and speed up allowance.",
        "Value-Tracked Scope: Crafting claim sets that track actual commercial product value, not just what is easiest to allow.",
        "PTAB Appeal Readiness: Decisive appeal preparation when necessary to correct Examiner errors and defend claim scope."
      ],
      vision: "To reshape patent prosecution from a passive response cycle into an active, data-driven negotiation that secures the exact monopoly rights you deserve.",
      mission: "To maintain a clean, resilient prosecution record that supports future licensing, transaction, and enforcement events."
    },
    {
      slug: "trademark-services",
      title: "Trademark Services",
      subtitle: "Smart Clearance, Brand Architecture, and Global Enforcement",
      category: "Preparation & Filing",
      image: "https://images.unsplash.com/photo-1560179707-f14e90ef3623?auto=format&fit=crop&q=80&w=1000",
      description: "Protecting your trademarks starts with smart clearance. We guide you through searches, risk assessments, and naming strategy so you avoid costly conflicts before filing. When you are ready to file, we prepare and prosecute applications, respond to Office Actions, and coordinate foreign filings through trusted associates. We also help police misuse, handle renewals, and structure coexistence or licensing arrangements to keep your brand strong.",
      bullets: [
        "Strategic Brand Clearance: Evaluating naming options, coordinating search reviews, and advising on brand architecture.",
        "Filing and Prosecution: Preparing clean specifications, drafting evidence plans, and actively responding to Office Actions.",
        "Global Portfolio Management: Coordinating foreign filings and multi-jurisdiction protection through trusted partners.",
        "Brand Enforcement & Policing: Developing monitoring strategies, managing renewals, and structuring coexistence agreements."
      ],
      vision: "To build and protect distinct, globally recognized brand identities that secure customer trust and command market premium.",
      mission: "To provide end-to-end trademark guidance, from early naming strategy to active enforcement, keeping your brand strong and conflict-free."
    },
    {
      slug: "opinions",
      title: "Opinions",
      subtitle: "Rigorous Invalidity, Non-Infringement, and Patentability Assessments",
      category: "Post-Grant & Proceedings",
      image: "https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&q=80&w=1000",
      description: "The law on the effects of formal legal opinion as a factor in determining willful infringement of a patent is still not settled. When uncertain whether you are possibly infringing a patent, our attorneys can analyze the problem patent and provide a legal written opinion about invalidity, non-infringement, and patentability that can guide you about the risks in continuing with the current course of action. A legal opinion is only as good as the technical understanding behind it. Our attorneys are engineers first, with backgrounds in electrical, computer, and mechanical engineering. We dig into schematic-level details to compare architectures, providing a robust technical foundation for our legal conclusions.",
      bullets: [
        "Non-Infringement Opinions: Detailed analysis explaining why your product does not practice specific patent claims.",
        "Invalidity Opinions: In-depth prior art research demonstrating that an asserted patent should not have been issued.",
        "Freedom to Operate (FTO) Opinions: Broader clearance analysis for safe product and feature launches.",
        "Willfulness Protection: Establishing good faith, due care, and legal diligence to protect against treble damages."
      ],
      vision: "To provide clear, unassailable technical and legal safe harbors that empower engineering teams to design and deploy products with absolute confidence.",
      mission: "To combine deep engineering forensics with precise legal analysis to produce actionable, executive-ready opinions."
    },
    {
      slug: "portfolio-analysis",
      title: "Portfolio Analysis",
      subtitle: "Aligning IP Assets to Commercial Outcomes & Moats",
      category: "Post-Grant & Proceedings",
      image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1000",
      description: "Portfolio analysis involves understanding the strengths and weaknesses of your patents in different technology areas, and identifying ways to improve your portfolio to make it more marketable or stronger in view of your products or processes. We have the engineering experience and knowledge to understand your technology, and legal expertise to understand the strength of your patent claims. Our experience can help you harvest new ideas and set the roadmap for future patents. We view IP through the lens of asset management, evaluating portfolios for market dominance, revenue generation, and defensive strength.",
      bullets: [
        "Claim Mapping & Coverage: Mapping issued patent claims directly to products, lines, or technical architectures.",
        "Moat Assessment: Evaluating the defensive and offensive strength of claims in blocking competitor entry.",
        "Whitespace Discovery: Identifying architectural gaps and future filing opportunities to harvest new ideas.",
        "Asset Rationalization: Reviewing maintenance costs to identify strategic assets vs. low-value expenses."
      ],
      vision: "To transform passive patent listings into highly coordinated corporate arsenals that dictate market terms and secure fundraising.",
      mission: "To deliver data-driven portfolio audits that align patent claims with product roadmaps and maximize return on intellectual capital."
    },
    {
      slug: "pto-proceedings-aia",
      title: "PTO Proceedings under the AIA",
      subtitle: "Navigating USPTO Trials (IPR, PGR, Derivations)",
      category: "Post-Grant & Proceedings",
      image: "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&q=80&w=1000",
      description: "Under the America Invents Act (AIA), six new proceedings were introduced by the USPTO including: Third Party pre-issuance submissions, Post Grant Review (an opposition proceeding), Inter partes review (IPR), Ex parte Re-Exam, Supplemental Examination, and Derivation Proceedings. We can help you navigate through a complex maze of rules and standards associated with these proceedings. Whether challenging an aggressive competitor's patent or defending your own crown jewels, we combine technical depth and trial expertise to manage these proceedings.",
      bullets: [
        "Inter Partes Review (IPR): Challenging patentability of claims based on patents or printed publications before the Board.",
        "Post Grant Review (PGR): Opposing newly issued patents within nine months of grant across all eligibility and validity grounds.",
        "Derivation Proceedings: USPTO trials to determine whether an earlier filer derived the invention from our client.",
        "Ex Parte Re-Examination: Deflecting asserted patents or bolstering client assets by citing prior art to the USPTO."
      ],
      vision: "To master administrative USPTO trial venues, providing a fast, cost-effective alternative to federal court litigation for resolving patent validity.",
      mission: "To defend or dismantle patent claims before the PTAB through surgical technical advocacy and rigid procedural compliance."
    },
    {
      slug: "reexamination-reissue",
      title: "Reexamination & Reissue",
      subtitle: "Post-Grant Portfolio Correction & Defense",
      category: "Post-Grant & Proceedings",
      image: "https://images.unsplash.com/photo-1447069387593-a5de0862481e?auto=format&fit=crop&q=80&w=1000",
      description: "As patents become the means for taking patent licenses, it is helpful to deflect such patents cited against your products or processes by initiating a Reexamination proceeding against the cited patent. We can guide you through this process to seek invalidity of the cited patent. Sometimes Reexamination of a patent is initiated to strengthen the patent before embarking on a future lawsuit against a third party. Our experienced attorneys can help search relevant prior art, if it exists, for considering reexamination of your own patent. We can also correct deficiencies of your existing patents by initiating a Reissue process for your issued patent.",
      bullets: [
        "Preemptively Immunizing Assets: Citing newly discovered prior art to the USPTO to strengthen patent claims before litigation.",
        "Broadening Reissue Filings: Expanding claims within two years of issuance to capture competitor products.",
        "Technical Corrections: Utilizing reissue to correct errors in priority, inventorship, or specifications.",
        "Deflecting Assertions: Initiating reexamination to challenge and invalidate patents cited against your processes."
      ],
      vision: "To provide dynamic post-grant correction capabilities that keep your patent assets perfectly aligned with shifting market landscapes.",
      mission: "To deploy reissue and reexamination as strategic maintenance levers, correcting defects and neutralizing third-party assertions."
    },
    {
      slug: "business-counseling-services",
      title: "Business Counseling Services",
      subtitle: "Founder-Friendly Operational and IP Governance Guidance",
      category: "Strategy & Commercialization",
      image: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&q=80&w=1000",
      description: "Business counseling covers operational agreement review, cap table review, and IP clauses to keep governance, equity, and ownership aligned. We focus on practical, founder-friendly advice that reduces risk before fundraising, hiring, or partnering. We review decision rights, transfer restrictions, vesting schedules, and IP assignment chains to ensure that your business has an investor-ready foundation.",
      bullets: [
        "Operational Agreement Review: Auditing decision rights, governance structure, and member obligations.",
        "Cap Table & Vesting Audits: Aligning equity ownership, option pools, and vesting triggers for founder departures.",
        "IP Chain-of-Title assignment: Securing complete assignment clauses in employment and contractor agreements.",
        "Fundraising Diligence Readiness: Delivering a clean, investor-ready legal and IP package to speed up pre-seed/seed rounds."
      ],
      vision: "To lay down bulletproof legal foundations for early-stage and high-growth companies, preventing costly equity and IP ownership disputes.",
      mission: "To provide clear, founder-centric counsel that manages operational risk without slowing down corporate momentum."
    },
    {
      slug: "freedom-to-operate",
      title: "Freedom to Operate",
      subtitle: "Mitigating Patent Litigation Risk through Landscaping",
      category: "Strategy & Commercialization",
      image: "https://images.unsplash.com/photo-1507537297725-24a1c029d3ca?auto=format&fit=crop&q=80&w=1000",
      description: "Freedom to Operate (FTO) are used to determine the patent landscape of the technology area you plan to adapt for your product or process. The idea is that you want to know if your product or process is possibly infringing an issued patent. We take time to understand your product or process roadmap, and identify patents that your products or process may infringe. FTO opinions can help with mitigating patent litigation risk. If a blocking patent is found, we support you in evaluating purchase, licensing, cross-licensing, or designing-around.",
      bullets: [
        "Roadmap-Aligned Search: Executing targeted patent landscape searches aligned directly to your product features.",
        "Risk Triage & Scoring: Filtering and prioritizing search results so your team focuses only on active, high-risk patents.",
        "Strategic Design-Around: Collaborative engineering feedback to modify product features and bypass known patents.",
        "Actionable Decision Support: Guiding options for licensing, acquisition, cross-licensing, or strategic delays."
      ],
      vision: "To provide comprehensive, predictive clearance studies that clear the path for bold product innovation.",
      mission: "To deliver clear-sighted, roadmap-aligned risk assessments that steer product teams away from infringement while keeping engineering changes cost-effective."
    },
    {
      slug: "ip-rights-government-contracts",
      title: "IP Rights in Government Contracts",
      subtitle: "Navigating Bayh-Dole, Data Rights, and Government Procurement",
      category: "Strategy & Commercialization",
      image: "https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?auto=format&fit=crop&q=80&w=1000",
      description: "Working with the U.S. Government can be a formidable challenge. Intellectual property rights in government procurement and sponsored research and development contracts are subject to different frameworks than those prevalent in the private sector. Navigating such frameworks requires IP counsel with knowledge of both IP protection regimes, as well as the ways government contracting and private sector IP protection strategies affect each other. We help manage Bayh-Dole requirements, Data Rights, Patent Rights, and Government Use Rights.",
      bullets: [
        "Bayh-Dole Compliance: Managing invention disclosures, title election, and commercialization requirements under federal funding.",
        "Data Rights Classification: Classifying technical data and software rights (Limited, Restricted, or Government Purpose Rights).",
        "SBIR/STTR Data Protection: Leveraging special data rights retention periods to prevent federal agency disclosure.",
        "Government Use Rights: Mitigating risk of federal 'march-in' rights and government royalty-free licenses."
      ],
      vision: "To demystify complex federal acquisition regulations (DFARS/FAR), ensuring commercial entities can safely contract with the US government while retaining core intellectual capital.",
      mission: "To secure proprietary data and patent rights during federal procurements and sponsored research, enabling clean commercialization."
    },
    {
      slug: "licensing-litigation-support",
      title: "Licensing & Litigation Support",
      subtitle: "Defending Assertions, Outbound Campaigns, and Litigation Readiness",
      category: "Strategy & Commercialization",
      image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&q=80&w=1000",
      description: "As you become successful, licensing opportunities knock on your door. We help with defensive analysis to identify defensive risk of the asserted patents to your current and future products. We prepare validity analysis of the patents and identify possible defenses to gauge the defensive risk. We also assist with purchasing opportunities of patents to protect your current and future products, and for possible offensive use of the patents. We also help companies treat their IP as a business asset through outbound licensing, cross-licensing, and IP valuation support.",
      bullets: [
        "Defensive Risk Analysis: Conducting prior art searches and validity analysis to dismantle third-party patent assertions.",
        "Claim-to-Product Mapping: Drafting precise 'evidence of use' claims charts to support cross-licensing and negotiations.",
        "Outbound Licensing Support: Identifying potential licensees, valuing assets, and structuring royalty agreements.",
        "Pre-Litigation Readiness: Preparing claim construction and technical records to position you for early, favorable settlement."
      ],
      vision: "To weaponize patent portfolios as high-yield financial assets and defensive moats, ensuring disputes are resolved from a position of technical dominance.",
      mission: "To guide clients through aggressive licensing negotiations and litigation threats with absolute analytical clarity and business-centric tradeoffs."
    }
  ];

  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} | MGF Law`}>
  <div class="min-h-screen bg-[#0A0F1D] text-white selection:bg-[#c5a880] selection:text-[#0A0F1D] pb-16">
    <main class="container mx-auto px-4 py-12 max-w-5xl flex-grow w-full font-sans">
      <!-- Breadcrumb -->
      <div class="mb-8 flex items-center justify-between border-b border-[#c5a880]/10 pb-4">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 font-medium">
          <a href="/" class="hover:text-[#c5a880] transition-colors">Home</a>
          <span>/</span>
          <a href="/services" class="hover:text-[#c5a880] transition-colors">Services</a>
          <span>/</span>
          <span class="text-[#c5a880]">{service.title}</span>
        </div>
        <a href="/services" class="text-[#c5a880] hover:underline font-bold text-xs sm:text-sm">← All Services</a>
      </div>

      <!-- Header Section -->
      <div class="mb-8 space-y-4">
        <span class="inline-block px-3 py-1 text-[10px] font-bold rounded-full border border-[#c5a880]/30 bg-[#c5a880]/5 text-[#c5a880] tracking-wider uppercase">
          {service.category}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold text-white leading-tight font-serif">
          {service.title}
        </h1>
        <p class="text-sm sm:text-lg text-slate-300 font-medium leading-relaxed max-w-3xl">
          {service.subtitle}
        </p>
      </div>

      <!-- Hero Banner Image -->
      <div class="relative w-full h-[280px] sm:h-[400px] rounded-2xl overflow-hidden border border-[#c5a880]/15 mb-12 shadow-lg">
        <img src={service.image} alt={service.title} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0F1D] via-transparent to-transparent opacity-90"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-10">
          <section class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold font-serif text-[#c5a880] border-b border-[#c5a880]/15 pb-2">Capability Overview</h2>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
              {service.description}
            </p>
          </section>

          <!-- Bullet Highlights -->
          <section class="bg-[#12192c] border border-[#c5a880]/15 p-6 sm:p-8 rounded-2xl shadow">
            <h3 class="text-lg sm:text-xl font-bold font-serif text-white mb-6">Core Competencies & Key Areas</h3>
            <ul class="space-y-4">
              {service.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 mt-0.5 text-[#c5a880] shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                  </svg>
                  <span class="text-slate-300 font-medium text-xs sm:text-sm leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Vision and Mission -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="border border-[#c5a880]/10 p-6 rounded-xl bg-[#12192c]/50">
              <h4 class="text-base sm:text-lg font-bold font-serif text-[#c5a880] mb-2">Our Vision</h4>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {service.vision}
              </p>
            </div>
            <div class="border border-[#c5a880]/10 p-6 rounded-xl bg-[#12192c]/50">
              <h4 class="text-base sm:text-lg font-bold font-serif text-[#c5a880] mb-2">Our Mission</h4>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {service.mission}
              </p>
            </div>
          </div>
        </div>

        <!-- Sidebar Call to Action -->
        <div class="bg-[#12192c] border border-[#c5a880]/15 p-6 rounded-2xl shadow lg:col-span-1 sticky top-6 space-y-6">
          <div>
            <h3 class="text-base sm:text-lg font-bold font-serif text-white mb-2">Consult with a Licensed Patent Attorney</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Speak to our co-founders about protecting, managing, or defending your IP assets worldwide.
            </p>
          </div>

          <div class="pt-4 border-t border-[#c5a880]/10">
            <a
              href={`/contact?subject=${encodeURIComponent('Brief: Inquiry on ' + service.title)}`}
              class="block text-center font-extrabold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all uppercase tracking-wider bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] shadow shadow-[#c5a880]/10"
            >
              Contact Attorney
            </a>
          </div>

          <div class="text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">
              Direct Office: (971) 634-0286
            </span>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
