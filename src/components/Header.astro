---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="container mx-auto px-4 py-4 max-w-6xl relative z-50 font-sans">
  <div class="flex justify-between items-center bg-[#12192c] border border-[#c5a880]/15 p-3 sm:p-4 rounded-xl shadow-md relative">
    
    <!-- Left Side: Brand Logo -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/" class="flex items-center gap-2 px-1 sm:px-3">
        <span class="font-serif text-lg sm:text-2xl font-black text-white tracking-tight whitespace-nowrap block">
          MGF <span class="text-[#c5a880] font-light">LAW</span>
        </span>
      </a>
    </div>
    
    <!-- Desktop Navigation Menu -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
      <a href="/about-us" class="text-xs xl:text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-2.5 py-2 rounded-lg transition-all">ABOUT US</a>
      <a href="/our-people" class="text-xs xl:text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-2.5 py-2 rounded-lg transition-all">OUR PEOPLE</a>
      
      <!-- Services Dropdown on Hover -->
      <div class="relative group">
        <a href="/services" class="flex items-center gap-1 text-xs xl:text-sm font-semibold text-slate-300 group-hover:text-[#c5a880] px-2.5 py-2 rounded-lg transition-all">
          <span>SERVICES</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#c5a880] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </a>
        
        <!-- Services Multi-Column Dropdown Menu -->
        <div class="absolute left-0 top-full pt-2 hidden group-hover:block z-50 min-w-[540px]">
          <div class="bg-[#12192c] border border-[#c5a880]/20 rounded-2xl shadow-2xl p-5 backdrop-blur-md space-y-4">
            <div class="grid grid-cols-3 gap-4 text-xs">
              
              <!-- Column 1: Preparation & Filing -->
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-[#c5a880] uppercase tracking-wider block border-b border-[#c5a880]/15 pb-1">
                  Prep & Filing
                </span>
                <div class="space-y-1">
                  <a href="/services/foreign-patent-prosecution" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Foreign Prosecution
                  </a>
                  <a href="/services/patent-preparation" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Patent Preparation
                  </a>
                  <a href="/services/patent-prosecution" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Patent Prosecution
                  </a>
                  <a href="/services/trademark-services" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Trademark Services
                  </a>
                </div>
              </div>

              <!-- Column 2: Post-Grant & Proceedings -->
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-[#c5a880] uppercase tracking-wider block border-b border-[#c5a880]/15 pb-1">
                  Post-Grant
                </span>
                <div class="space-y-1">
                  <a href="/services/opinions" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Legal Opinions
                  </a>
                  <a href="/services/portfolio-analysis" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Portfolio Analysis
                  </a>
                  <a href="/services/pto-proceedings-aia" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    PTO Proceedings (AIA)
                  </a>
                  <a href="/services/reexamination-reissue" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Reexamination & Reissue
                  </a>
                </div>
              </div>

              <!-- Column 3: Strategy & Commercialization -->
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-[#c5a880] uppercase tracking-wider block border-b border-[#c5a880]/15 pb-1">
                  Strategy & IP
                </span>
                <div class="space-y-1">
                  <a href="/services/business-counseling-services" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Business Counseling
                  </a>
                  <a href="/services/freedom-to-operate" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Freedom to Operate
                  </a>
                  <a href="/services/ip-rights-government-contracts" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Government Contracts
                  </a>
                  <a href="/services/licensing-litigation-support" class="block px-2 py-1 rounded text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
                    Licensing & Litigation
                  </a>
                </div>
              </div>

            </div>

            <div class="border-t border-[#c5a880]/10 pt-2 flex items-center justify-between">
              <span class="text-[11px] text-slate-400">12 Specialized Practice Areas</span>
              <a href="/services" class="text-[11px] font-bold text-[#c5a880] hover:underline flex items-center gap-1">
                <span>View All Services</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Technologies Dropdown on Hover -->
      <div class="relative group">
        <a href="/technologies" class="flex items-center gap-1 text-xs xl:text-sm font-semibold text-slate-300 group-hover:text-[#c5a880] px-2.5 py-2 rounded-lg transition-all">
          <span>TECHNOLOGIES</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#c5a880] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </a>
        
        <!-- Technologies Dropdown Menu -->
        <div class="absolute left-0 top-full pt-2 hidden group-hover:block z-50 min-w-[280px]">
          <div class="bg-[#12192c] border border-[#c5a880]/20 rounded-xl shadow-2xl p-2.5 space-y-1 backdrop-blur-md">
            <a href="/technologies/artificial-intelligence" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Artificial Intelligence
            </a>
            <a href="/technologies/biological-arts" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Biological Arts
            </a>
            <a href="/technologies/chemical-arts" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Chemical Arts
            </a>
            <a href="/technologies/data-security-identity" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Data Security & Identity
            </a>
            <a href="/technologies/electrical-arts-consumer-electronics" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Electrical Arts & Electronics
            </a>
            <a href="/technologies/mechanical-arts" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Mechanical Arts
            </a>
            <a href="/technologies/semiconductor-optical-mems-devices" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Semiconductors & MEMS
            </a>
            <a href="/technologies/software-arts" class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-[#c5a880]/15 transition-all">
              Software Arts
            </a>
            <div class="border-t border-[#c5a880]/10 mt-1 pt-1">
              <a href="/technologies" class="px-3 py-2 rounded-lg text-[11px] font-bold text-[#c5a880] hover:bg-[#c5a880]/10 transition-all flex items-center justify-between">
                <span>View All Technologies</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Insights Navigation Item -->
      <a href="/insights" class="text-xs xl:text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-2.5 py-2 rounded-lg transition-all">INSIGHTS</a>
    </nav>

    <!-- Desktop Controls & Contact -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-4">
      <div class="flex flex-col text-right">
        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Mon-Fri 9AM-5PM</span>
        <a href="tel:9716340286" class="text-xs font-bold text-white hover:text-[#c5a880] transition-colors">(971) 634-0286</a>
      </div>
      <div class="w-px h-6 bg-[#c5a880]/20 mx-1"></div>
      <ThemeToggle />
      <a href="/contact" class="h-10 flex items-center justify-center px-4 xl:px-5 rounded-lg font-extrabold text-xs tracking-wider uppercase bg-[#c5a880] text-[#0A0F1D] hover:bg-[#b0936b] transition-all ml-1 shadow shadow-[#c5a880]/10">
        CONTACT
      </a>
    </div>

    <!-- Mobile Burger Menu Button -->
    <div class="lg:hidden flex items-center gap-2">
      <ThemeToggle />
      <button id="mobile-menu-trigger" aria-label="Open menu" aria-expanded="false" class="h-10 w-10 flex items-center justify-center rounded-xl text-foreground hover:text-accent hover:bg-secondary transition-colors border border-transparent shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      
      <!-- Mobile Dropdown Panel -->
      <div id="mobile-menu-panel" class="absolute top-full left-0 right-0 mt-2 rounded-xl border border-[#c5a880]/15 bg-[#12192c] shadow-lg p-4 hidden space-y-4 max-h-[85vh] overflow-y-auto">
        <nav class="flex flex-col gap-2">
          <a href="/about-us" class="text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-3 py-2 rounded-lg transition-all">ABOUT US</a>
          <a href="/our-people" class="text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-3 py-2 rounded-lg transition-all">OUR PEOPLE</a>
          <a href="/services" class="text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-3 py-2 rounded-lg transition-all">SERVICES</a>
          <a href="/technologies" class="text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-3 py-2 rounded-lg transition-all">TECHNOLOGIES</a>
          <a href="/insights" class="text-sm font-semibold text-slate-300 hover:text-[#c5a880] px-3 py-2 rounded-lg transition-all">INSIGHTS</a>
          <a href="/contact" class="text-sm font-bold text-[#c5a880] px-3 py-2 rounded-lg transition-all">CONTACT US</a>
        </nav>
      </div>
    </div>

  </div>
</header>

<script>
  function initMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const panel = document.getElementById('mobile-menu-panel');
    
    if (trigger && panel) {
      if (!trigger.dataset.init) {
        trigger.dataset.init = 'true';
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = panel.classList.contains('hidden');
          if (isHidden) {
            panel.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            panel.classList.add('hidden');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });
        
        document.addEventListener('click', () => {
          panel.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        });
      }
    }
  }

  document.addEventListener('astro:page-load', initMobileMenu);
  initMobileMenu();
</script>
