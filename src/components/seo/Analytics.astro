---
export interface Props {
  gaId?: string;
}

const { gaId = 'G-MJJVXRWZ1F' } = Astro.props;
---

<!-- Set default consent mode -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied'
  });
</script>

<!-- Google tag (gtag.js) -->
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-MJJVXRWZ1F');
</script>

<!-- Microsoft Clarity -->
<script is:inline type="text/javascript">
  window.loadClarity = function() {
    if (!window.clarityLoaded) {
      window.clarityLoaded = true;
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xngqthz4kz");
    }
  };
  
  // Load immediately if consent was already granted
  if (typeof localStorage !== 'undefined' && localStorage.getItem('cookie-consent') === 'accepted') {
    window.loadClarity();
  }
</script>
